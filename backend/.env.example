# LLM
GROQ_API_KEY=

# Database — either DATABASE_URL *or* the DB_* fields below
# DATABASE_URL=postgresql+psycopg2://postgres:PASSWORD@db.xxxxx.supabase.co:5432/postgres?sslmode=require

DB_USER=postgres
DB_PASSWORD=
DB_HOST=db.xxxxx.supabase.co
DB_PORT=5432
DB_NAME=postgres

# Auth
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Cache — local: redis://localhost:6379/0
# Upstash: rediss://default:TOKEN@xxxx.upstash.io:6379  (note rediss = TLS)
REDIS_URL=redis://localhost:6379/0
SEARCH_CACHE_TTL=3600

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000
