# LLM
GROQ_API_KEY=
# Models must be enabled for your Groq key; the llama-* models are not.
# Each *_FALLBACK_MODELS list is tried in order when the model above is
# unavailable, rate limited, or erroring. Leave unset to use the defaults.
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_CHAT_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
# Search pipeline (query extraction, patient profile, eligibility rewriting)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b

# Database — either DATABASE_URL *or* the DB_* fields below
# DATABASE_URL=postgresql+psycopg2://postgres:PASSWORD@db.xxxxx.supabase.co:5432/postgres?sslmode=require

DB_USER=postgres
DB_PASSWORD=
DB_HOST=db.xxxxx.supabase.co
DB_PORT=5432
DB_NAME=postgres

# Auth
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Cache — local: redis://localhost:6379/0
# Upstash: rediss://default:TOKEN@xxxx.upstash.io:6379  (note rediss = TLS)
REDIS_URL=redis://localhost:6379/0
SEARCH_CACHE_TTL=3600

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000
